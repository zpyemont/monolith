ARG ARTIFACTS_IMAGE
FROM ${ARTIFACTS_IMAGE}

# Copy fashion two-tower model
COPY ./fashion_model_two_tower.py /fashion_model_two_tower.py

# Copy precompute script for item embeddings
COPY ./scripts/precompute_item_embeddings.py /precompute_item_embeddings.py

# Copy necessary shared scripts and configs
COPY markdown/demo/ml_dataset.py /ml_dataset.py
COPY demo.conf /demo.conf
COPY fashion.conf /fashion.conf
COPY two_tower.conf /two_tower.conf
COPY monolith/agent_service/agent_controller.py /usr/local/lib/python3.8/site-packages/monolith/agent_service/agent_controller.py
COPY conf/platform_config_file.cfg /conf/platform_config_file.cfg

RUN ln -sf /usr/local/lib/python3.8/site-packages/monolith/agent_service/agent.py /agent.py

# Install BigQuery client + pandas for fast to_dataframe() loading
# Pin versions compatible with TF 2.4's numpy ~1.19.2
RUN python3 -m pip install --no-cache-dir \
    'protobuf>=3.19.0,<4.0.0' \
    'google-cloud-bigquery==2.20.0' \
    'grpcio>=1.32.0,<1.40.0' \
    'pytz' \
    'numpy>=1.19.2,<1.20.0' \
    'pandas>=1.1.0,<1.4.0' \
    'pyarrow>=3.0.0,<6.0.0' \
    'pyfarmhash'

# SSL certificates should already be in base image
# Only update if needed (skip ca-certificates-java to avoid pulling Java/190MB)

# Set SSL certificate environment variables
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_DIR=/etc/ssl/certs
ENV MONOLITH_TFS_BINARY=/output/bin/tensorflow_model_server

# Prepare checkpoint directory
RUN mkdir -p /checkpoints && chmod 777 /checkpoints

# Remove compiled .so files so Python uses our updated .py versions
RUN rm -f /usr/local/lib/python3.8/site-packages/monolith/native_training/cpu_training*.so
RUN rm -f /usr/local/lib/python3.8/site-packages/monolith/native_training/distributed_serving_ops*.so

# Copy all required files for parameter sync with hooks support
COPY ./monolith/agent_service/backends.py /usr/local/lib/python3.8/site-packages/monolith/agent_service/backends.py
COPY ./monolith/native_training/sync_training_hooks.py /usr/local/lib/python3.8/site-packages/monolith/native_training/sync_training_hooks.py
COPY ./monolith/native_training/cpu_training.py /usr/local/lib/python3.8/site-packages/monolith/native_training/cpu_training.py
COPY ./monolith/native_training/estimator.py /usr/local/lib/python3.8/site-packages/monolith/native_training/estimator.py
COPY ./monolith/native_training/distributed_serving_ops.py /usr/local/lib/python3.8/site-packages/monolith/native_training/distributed_serving_ops.py
COPY ./monolith/native_training/model_export/export_context.py /usr/local/lib/python3.8/site-packages/monolith/native_training/model_export/export_context.py

ENTRYPOINT ["python3", "/fashion_model_two_tower.py"]
# Default to batch training mode
CMD ["--training_type=batch"]
